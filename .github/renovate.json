{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "java"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "the slf4j-api version in the README install snippet, kept in step with the pom",
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["<artifactId>slf4j-api</artifactId>\\s*<version>(?<currentValue>[^<]+)</version>"],
      "depNameTemplate": "org.slf4j:slf4j-api",
      "datasourceTemplate": "maven"
    }
  ]
}
